# Kopirajte ovaj fajl u .env.local i prilagodite vrijednosti.
# NEXT_PUBLIC_* varijable se ugrađuju u stranice prilikom `npm run build`,
# pa nakon izmjene morate ponovo pokrenuti build.

# Adresa prodavnice (bez kose crte na kraju). Koristi se za canonical linkove, sitemap i e-mailove.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontakt i podaci o firmi (prikazuju se na stranicama Kontakt, Uslovi i Privatnost)
NEXT_PUBLIC_CONTACT_EMAIL=info@zdjelica.ba
NEXT_PUBLIC_CONTACT_PHONE=+387 61 000 000
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_ID=

# Baza (SQLite). Putanja mora biti na trajnom disku servera.
# DATABASE_PATH=/var/lib/zdjelica/zdjelica.db

# E-pošta (SMTP). Bez ovoga se poruke samo ispisuju u konzolu.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Zdjelica <info@zdjelica.ba>

# Na ovu adresu stiže e-mail sa svakom novom narudžbom (za proslijeđivanje dobavljaču).
ORDER_NOTIFY_EMAIL=

# Dodatni admini po e-mail adresi (odvojene zarezom). Preporučeno je umjesto toga
# napraviti admin račun komandom: npm run admin:create -- e-mail "Ime" "lozinka"
ADMIN_EMAILS=

# Tajna za dnevni cron koji šalje podsjetnike (npr. dugačak nasumičan niz).
CRON_SECRET=
